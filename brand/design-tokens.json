{
  "$schema": "https://schemas.figma.com/tokens/v1.json",
  "name": "Mundiales de Fútbol",
  "version": "2.0.0",
  "description": "Design tokens del portal (sistema Claude Design 2026-10). Drop into Figma Tokens, Style Dictionary o Tailwind v4 @theme.",
  "color": {
    "bg": {
      "value": "#05060A",
      "type": "color",
      "description": "Fondo principal, negro profundo con tinte azul."
    },
    "bg-2": {
      "value": "#0B0D14",
      "type": "color",
      "description": "Fondo secundario para cards y secciones alternas."
    },
    "surface": {
      "value": "#101319",
      "type": "color"
    },
    "fg": {
      "value": "#F5F6F8",
      "type": "color",
      "description": "Texto principal (casi blanco)."
    },
    "fg-muted": {
      "value": "#A3A8B2",
      "type": "color",
      "description": "Texto secundario."
    },
    "fg-subtle": {
      "value": "#80858F",
      "type": "color",
      "description": "Etiquetas y metadatos (AA a 11 px)."
    },
    "border": {
      "value": "rgba(255,255,255,0.08)",
      "type": "color"
    },
    "border-strong": {
      "value": "rgba(255,255,255,0.18)",
      "type": "color"
    },
    "pitch": {
      "value": "#00FF85",
      "type": "color",
      "description": "Acento de marca (CTA, selección) y del fútbol."
    },
    "pitch-deep": {
      "value": "#00C266",
      "type": "color"
    },
    "flame": {
      "value": "#FF3B3B",
      "type": "color",
      "description": "Alias de live (archivo histórico)."
    },
    "sun": {
      "value": "#FFD400",
      "type": "color",
      "description": "Alias de gold (archivo histórico)."
    },
    "surface-2": {
      "value": "#161A22",
      "type": "color",
      "description": "Superficie elevada secundaria."
    },
    "live": {
      "value": "oklch(0.68 0.22 25)",
      "type": "color",
      "description": "En directo (relleno, pulso). Alias heredado: flame."
    },
    "live-ink": {
      "value": "oklch(0.74 0.19 25)",
      "type": "color",
      "description": "En directo (texto)."
    },
    "win": {
      "value": "oklch(0.80 0.17 150)",
      "type": "color",
      "description": "Victoria, ascenso, clasificado."
    },
    "draw": {
      "value": "oklch(0.72 0.01 260)",
      "type": "color",
      "description": "Empate."
    },
    "loss": {
      "value": "oklch(0.68 0.17 10)",
      "type": "color",
      "description": "Derrota, descenso, roja."
    },
    "gold": {
      "value": "oklch(0.88 0.18 92)",
      "type": "color",
      "description": "Campeón, descanso, amarilla. Alias heredado: sun."
    }
  },
  "typography": {
    "display": {
      "family": "Bebas Neue",
      "fallback": "Impact, system-ui, sans-serif",
      "weights": [
        400
      ],
      "letterSpacing": "-0.01em"
    },
    "sans": {
      "family": "Geist",
      "fallback": "ui-sans-serif, system-ui, sans-serif",
      "weights": [
        400,
        500,
        600,
        700
      ]
    },
    "mono": {
      "family": "Geist Mono",
      "fallback": "ui-monospace, monospace",
      "weights": [
        400,
        500
      ]
    },
    "arabic": {
      "family": "Noto Naskh Arabic",
      "fallback": "serif"
    },
    "scale": {
      "display": "clamp(3.5rem, 13vw, 14rem)",
      "h1": "clamp(2.25rem, 5vw, 4.5rem)",
      "h2": "clamp(1.75rem, 3.5vw, 3rem)",
      "body-lg": "1.25rem",
      "body": "1rem",
      "body-sm": "0.875rem",
      "kicker": "0.75rem",
      "micro": "0.625rem"
    },
    "treatments": {
      "kicker": {
        "family": "mono",
        "size": "kicker",
        "transform": "uppercase",
        "tracking": "0.3em",
        "color": "pitch"
      },
      "hero": {
        "family": "display",
        "size": "display",
        "transform": "uppercase",
        "lineHeight": "0.88",
        "tracking": "-0.035em"
      },
      "numeric-stat": {
        "family": "display",
        "size": "h1",
        "fontVariantNumeric": "tabular-nums",
        "lineHeight": "1"
      }
    }
  },
  "radius": {
    "sm": "6px",
    "md": "10px",
    "lg": "18px",
    "xl": "28px",
    "full": "9999px"
  },
  "spacing": {
    "section-y": "6rem",
    "section-y-md": "8rem",
    "gutter": "1.5rem",
    "gutter-md": "2.5rem",
    "max-width": "1400px"
  },
  "motion": {
    "ease-swift": "cubic-bezier(0.22, 1, 0.36, 1)",
    "duration-fast": "200ms",
    "duration-normal": "400ms",
    "duration-slow": "900ms",
    "duration-spin": "40s"
  },
  "gradients": {
    "hero-title": {
      "value": "linear-gradient(90deg, #00FF85 0%, #FFD400 50%, #FF3B3B 100%)",
      "description": "Se aplica sólo a la segunda línea del headline principal."
    },
    "hero-backdrop": {
      "value": "conic-gradient(from 0deg at 50% 50%, rgba(0,255,133,0.35), rgba(255,59,59,0.35), rgba(255,212,0,0.35), rgba(0,255,133,0.35))",
      "blur": "120px",
      "opacity": 0.6
    },
    "pitch-glow": "radial-gradient(60% 50% at 50% 0%, rgba(0,255,133,0.18) 0%, transparent 70%)",
    "flame-glow": "radial-gradient(40% 40% at 80% 10%, rgba(255,59,59,0.25) 0%, transparent 70%)"
  },
